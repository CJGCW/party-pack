{
  "name": "party-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Jackbox-style party game collection played over the local network.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "dev:debug": "cross-env PARTY_PACK_DEBUG=1 tsx watch --clear-screen=false server/index.ts",
    "dev:woocha": "cross-env PARTY_PACK_WOOCHA_DEBUG=1 tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "vite build && cross-env NODE_ENV=production tsx server/index.ts",
    "app:build": "vite build --mode app && cap sync android",
    "app:install": "npm run app:build && tsx scripts/android.ts installDebug",
    "app:apk": "npm run app:build && tsx scripts/android.ts assembleDebug",
    "bot": "tsx scripts/bot.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/**/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "an-array-of-english-words": "^2.0.0",
    "express": "^4.21.2",
    "naughty-words": "^1.2.0",
    "obscenity": "^0.4.6",
    "phaser": "^3.90.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "wordnet-db": "^3.1.14"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
